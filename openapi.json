{
  "openapi": "3.1.0",
  "info": {
    "title": "Flock Energy API",
    "description": "Read-only proxy for verified Urja portal operations.",
    "version": "0.1.0"
  },
  "paths": {
    "/meters": {
      "get": {
        "summary": "Search Meters",
        "operationId": "search_meters_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Q"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalPage_MeterSummary_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}/geo": {
      "get": {
        "summary": "Get Meter Location",
        "operationId": "get_meter_location_meters__meter_id__geo_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterLocationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}/energy": {
      "get": {
        "summary": "Get Meter Energy",
        "operationId": "get_meter_energy_meters__meter_id__energy_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnergyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transformers": {
      "get": {
        "summary": "List Transformers",
        "operationId": "list_transformers_transformers_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalPage_DistributionTransformer_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DistributionTransformer": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "feederCode": {
            "type": "string",
            "title": "Feedercode"
          },
          "capacityKva": {
            "type": "number",
            "title": "Capacitykva"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "name",
          "feederCode",
          "capacityKva"
        ],
        "title": "DistributionTransformer"
      },
      "EnergyReading": {
        "properties": {
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "kwh": {
            "type": "string",
            "title": "Kwh"
          },
          "kvah": {
            "type": "string",
            "title": "Kvah"
          },
          "voltR": {
            "type": "string",
            "title": "Voltr"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp",
          "kwh",
          "kvah",
          "voltR"
        ],
        "title": "EnergyReading"
      },
      "EnergyResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/EnergyReading"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data"
        ],
        "title": "EnergyResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InstallStatus": {
        "type": "string",
        "enum": [
          "Installed",
          "Faulty",
          "Decommissioned"
        ],
        "title": "InstallStatus"
      },
      "MeterLocation": {
        "properties": {
          "latitude": {
            "type": "string",
            "title": "Latitude"
          },
          "longitude": {
            "type": "string",
            "title": "Longitude"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "MeterLocation"
      },
      "MeterLocationResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MeterLocation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data"
        ],
        "title": "MeterLocationResponse"
      },
      "MeterSummary": {
        "properties": {
          "meterId": {
            "type": "string",
            "title": "Meterid"
          },
          "serialNo": {
            "type": "string",
            "title": "Serialno"
          },
          "make": {
            "type": "string",
            "title": "Make"
          },
          "phaseType": {
            "$ref": "#/components/schemas/PhaseType"
          },
          "installStatus": {
            "$ref": "#/components/schemas/InstallStatus"
          },
          "dtCode": {
            "type": "string",
            "title": "Dtcode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "meterId",
          "serialNo",
          "make",
          "phaseType",
          "installStatus",
          "dtCode"
        ],
        "title": "MeterSummary"
      },
      "PhaseType": {
        "type": "string",
        "enum": [
          "single",
          "three"
        ],
        "title": "PhaseType"
      },
      "PortalPage_DistributionTransformer_": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/DistributionTransformer"
            },
            "type": "array",
            "title": "Data"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pageSize": {
            "type": "integer",
            "title": "Pagesize"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data",
          "total",
          "page",
          "pageSize"
        ],
        "title": "PortalPage[DistributionTransformer]"
      },
      "PortalPage_MeterSummary_": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/MeterSummary"
            },
            "type": "array",
            "title": "Data"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pageSize": {
            "type": "integer",
            "title": "Pagesize"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data",
          "total",
          "page",
          "pageSize"
        ],
        "title": "PortalPage[MeterSummary]"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
